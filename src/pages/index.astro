---
const rutinas = [
  {
    id: "fuerza",
    nombre: "Fuerza",
    desc: "Una rutina de fuerza efectiva se basa en ejercicios multiarticulares que trabajan varios grupos musculares al mismo tiempo, utilizando una sobrecarga progresiva (aumentar el peso o las repeticiones con el tiempo) y un descanso adecuado.",
    portada: "https://content21.sabervivirtv.com/medio/2024/12/12/entrenamiento-fuerza_f5ec0d70_241212170359_990x660.webp",
    galeria: [
      "https://content21.sabervivirtv.com/medio/2024/12/12/entrenamiento-fuerza_f5ec0d70_241212170359_990x660.webp",
      "https://media.istockphoto.com/id/2027278401/es/foto/atleta-femenina-feliz-teniendo-entrenamiento-de-fuerza-en-un-gimnasio.jpg?s=612x612&w=0&k=20&c=heoz38mUUBBE0OHHIh_AB3EwTEd4ffYAZlYGvleSTB4=",
      "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRZP7qM5KWGalej-8t5fqPrwvoAqZgkqn-SCAmRsnjCz5giNx5q-QW1L2I&s=10"
    ]
  },
  {
    id: "cardio",
    nombre: "Cardio",
    desc: "El cardio es un tipo de ejercicio físico que ayuda a mejorar la resistencia, fortalecer el corazón y los pulmones, y quemar calorías. Se realiza mediante actividades como correr, saltar la cuerda, andar en bicicleta o caminar a paso rápido.",
    portada: "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTpj6D6A2yJqc3PQSfwg5-1kB8CL6VusOxer0ttCg8lwg&s=10",
    galeria: [
      "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTpj6D6A2yJqc3PQSfwg5-1kB8CL6VusOxer0ttCg8lwg&s=10",
      "https://media.istockphoto.com/id/1132086660/es/foto/vista-lateral-de-la-mujer-musculosa-hermosa-corriendo-en-la-cinta.jpg?s=612x612&w=0&k=20&c=NVS7gyHC9_XNjGHDorwxiQLk11bFUBz6sxMIlS8El1s=",
      "https://media.istockphoto.com/id/1289416200/es/foto/mujer-atl%C3%A9tica-haciendo-el-entrenamiento-cardiovascular-de-cuerpo-entero.jpg?s=1024x1024&w=is&k=20&c=MFv6W5cmQk_IjZCCPCR_h8uKb3fBx0OTAL-2D6T1sVU="
    ]
  },
  {
    id: "tonificacion",
    nombre: "Tonificación",
    desc: "La tonificación es un tipo de ejercicio físico que ayuda a fortalecer los músculos y mejorar la firmeza del cuerpo. Se realiza mediante ejercicios con pesas, máquinas o el propio peso corporal, como sentadillas, abdominales y flexiones.",
    portada: "https://media.istockphoto.com/id/2027281054/es/foto/joven-deportista-haciendo-abdominales-laterales-con-bal%C3%B3n-medicinal-mientras-hace-ejercicio-en.jpg?s=612x612&w=0&k=20&c=GMJNds-07Fj5FV_waHIYzRIvba49nsY4zcPNqADaEno=",
    galeria: [
      "https://media.istockphoto.com/id/2027281054/es/foto/joven-deportista-haciendo-abdominales-laterales-con-bal%C3%B3n-medicinal-mientras-hace-ejercicio-en.jpg?s=612x612&w=0&k=20&c=GMJNds-07Fj5FV_waHIYzRIvba49nsY4zcPNqADaEno=",
      "https://clinicadefitness.com/wp-content/uploads/2025/05/Entrenador-guiando-rutina-con-electroestimulacion-%E2%80%93-tonificacion-muscular-1024x683.webp",
      "https://media.revistagq.com/photos/672b9984cf8d8342b9efd35a/16:9/w_2560%2Cc_limit/1141400386"
    ]
  }
];

const bebidas = [
  {
    id: "agua",
    nombre: "Agua",
    img: "https://vilcagua.com.ec/wp-content/uploads/2023/07/vilcagua-500ml-1.jpeg",
    marcas: [
      { nombre: "Agua Vilcagua 500ml", img: "https://vilcagua.com.ec/wp-content/uploads/2023/07/vilcagua-500ml-1.jpeg", desc: "Hidratación pura y fresca para tu sesión de entrenamiento." }
    ]
  },
  {
    id: "proteinas",
    nombre: "Proteínas",
    img: "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQQc5UXUdR2ttvTYxXSgQ55CXSUoDSFR9DLwfr6XHANrw&s=10",
    marcas: [
      { nombre: "Proteína Carnivor", img: "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQQc5UXUdR2ttvTYxXSgQ55CXSUoDSFR9DLwfr6XHANrw&s=10", desc: "Proteína aislada de carne vacuna para máxima recuperación muscular." }
    ]
  },
  {
    id: "preentrenos",
    nombre: "Pre-entrenos y Creatina",
    img: "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTTvSM_8TYk7Q53bHd19kRWG_t-fxS0WmU8sMkr030_0w&s=10",
    marcas: [
      { nombre: "Creatina Beast Bites", img: "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTTvSM_8TYk7Q53bHd19kRWG_t-fxS0WmU8sMkr030_0w&s=10", desc: "Gominolas masticables de creatina para potenciar tu energía." },
      { nombre: "Creatina Monohidratada RC", img: "https://activelife.ec/wp-content/uploads/2024/08/ronnie-coleman-creatina-120.jpg", desc: "Creatina de Ronnie Coleman para fuerza y rendimiento explosivo." },
      { nombre: "Café de Especialidad", img: "https://www.shutterstock.com/image-photo/espresso-coffee-transparent-cup-260nw-2512810809.jpg", desc: "Estimulante natural previo a tu entrenamiento." }
    ]
  }
];

const horarios = [
  { dia: "Lunes - Viernes", hora: "05:00 a 09:30 / 14:30 a 22:00" },
  { dia: "Sábados", hora: "06:00 a 09:30 (Tarde cerrado)" },
  { dia: "Domingos", hora: "Cerrado" }
];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MAU FITNESS - Gimnasio</title>
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <main class="container">
      <!-- Cabecera unificada con Logo Centrado y Redes Abajo -->
      <header class="header-unificado">
        <div class="logo-container">
          <img src="/logo.png" alt="MAU FITNESS Logo" class="brand-logo" />
        </div>
        <div class="social-icons-center">
          <a href="https://www.instagram.com/maufitness.co/" target="_blank" rel="noopener noreferrer" title="Instagram" class="social-btn">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
          </a>
          <a href="https://www.tiktok.com/@maufitness.co" target="_blank" rel="noopener noreferrer" title="TikTok" class="social-btn">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 1 1-5.2-1.74 2.89 2.89 0 0 1 2.31-2.82V7.65a6.34 6.34 0 0 0-5.36 6.3 6.34 6.34 0 0 0 10.82 4.48c1.64-1.64 2.55-3.87 2.55-6.22V8.92a8.28 8.28 0 0 0 4.86 1.57V7.05a4.84 4.84 0 0 1-2.76-.36z"></path></svg>
          </a>
        </div>
      </header>

      <!-- Hero Principal Integrado -->
      <section class="hero">
        <div class="hero-content">
          <h1>DISCIPLINA HOY, <br /><span class="orange">RESULTADOS MAÑANA</span></h1>
          <p>Tu mejor versión comienza aquí.</p>
        </div>
        <div class="hero-card">
          <a href="https://wa.me/593998974837?text=¡Hola!%20Quiero%20solicitar%20información%20sobre%20los%20planes%20de%20MAU%20FITNESS." target="_blank" rel="noopener noreferrer" class="btn-orange">
            QUIERO MI PLAN ➔
          </a>
        </div>
      </section>

      <!-- Planes Interactivos -->
      <section class="section" id="planes">
        <h2>PLANES Y PRECIOS</h2>
        <p class="subtitle">Haz clic en un plan para ver sus valores y tarifas</p>
        <div class="planes-grid">
          <div class="plan-card-main" onclick="openPlanModal('normal')">
            <div class="plan-content-box">
              <h3>PLAN NORMAL</h3>
              <p>Tarifas generales para adultos y entrenamientos regulares.</p>
              <span class="btn-ver-valores">Ver valores ➔</span>
            </div>
          </div>
          <div class="plan-card-main" onclick="openPlanModal('estudiantes')">
            <div class="plan-content-box">
              <h3>PLAN ESTUDIANTES</h3>
              <p>Tarifas especiales y accesibles con credencial estudiantil.</p>
              <span class="btn-ver-valores">Ver valores ➔</span>
            </div>
          </div>
        </div>

        <!-- Modal Plan Normal -->
        <div id="modal-plan-normal" class="modal-overlay" onclick="closePlanModal('normal')">
          <div class="modal-content" onclick="event.stopPropagation()">
            <button class="modal-close" onclick="closePlanModal('normal')">✕</button>
            <h3 class="modal-title">PLAN NORMAL - Valores</h3>
            <p class="subtitle">Elige el periodo que prefieras</p>
            <div class="modal-precios-list">
              <div class="modal-row"><span>Mensual</span> <strong>$20</strong></div>
              <div class="modal-row"><span>Trimestral</span> <strong>$40</strong></div>
            </div>
          </div>
        </div>

        <!-- Modal Plan Estudiantes -->
        <div id="modal-plan-estudiantes" class="modal-overlay" onclick="closePlanModal('estudiantes')">
          <div class="modal-content" onclick="event.stopPropagation()">
            <button class="modal-close" onclick="closePlanModal('estudiantes')">✕</button>
            <h3 class="modal-title">PLAN ESTUDIANTES - Valores</h3>
            <p class="subtitle">Tarifas preferenciales para estudiantes</p>
            <div class="modal-precios-list">
              <div class="modal-row"><span>Diario</span> <strong>$1</strong></div>
              <div class="modal-row"><span>Mensual</span> <strong>$15</strong></div>
              <div class="modal-row"><span>Trimestral</span> <strong>$25</strong></div>
            </div>
          </div>
        </div>
      </section>

      <!-- Rutinas Interactivas -->
      <section class="section" id="rutinas">
        <h2>RUTINAS</h2>
        <p class="subtitle">Haz clic en una categoría para explorar el entrenamiento</p>
        <div class="rutinas-grid">
          {rutinas.map((item) => (
            <div class="rutina-card" onclick={`openRutinaModal('${item.id}')`}>
              <div class="rutina-img-bg" style={`background-image: linear-gradient(to top, rgba(0,0,0,0.9), rgba(0,0,0,0.2)), url('${item.portada}')`}>
                <span class="rutina-badge">Toca para ver ➔</span>
                <div class="rutina-title-box">
                  <h3>{item.nombre}</h3>
                </div>
              </div>
            </div>
          ))}
        </div>

        {rutinas.map((item) => (
          <div id={`modal-${item.id}`} class="modal-overlay" onclick={`closeRutinaModal('${item.id}')`}>
            <div class="modal-content" onclick="event.stopPropagation()">
              <button class="modal-close" onclick={`closeRutinaModal('${item.id}')`}>✕</button>
              <h3 class="modal-title">{item.nombre}</h3>
              <p class="modal-desc">{item.desc}</p>
              <h4>Galería de Ejercicios</h4>
              <div class="modal-gallery">
                {item.galeria.map((imgUrl) => (
                  <div class="gallery-img-box">
                    <img src={imgUrl} alt={item.nombre} />
                  </div>
                ))}
              </div>
            </div>
          </div>
        ))}
      </section>

      <!-- Bebidas y Suplementos -->
      <section class="section" id="bebidas">
        <h2>BEBIDAS Y SUPLEMENTOS</h2>
        <p class="subtitle">Selecciona una categoría para conocer nuestras marcas disponibles</p>
        <div class="bebidas-grid">
          {bebidas.map((cat) => (
            <div class="bebida-card" onclick={`openBebidaModal('${cat.id}')`}>
              <div class="bebida-img-container">
                <img src={cat.img} alt={cat.nombre} />
              </div>
              <div class="bebida-info">
                <h3>{cat.nombre}</h3>
                <span class="btn-ver-marcas">Ver marcas ➔</span>
              </div>
            </div>
          ))}
        </div>

        {bebidas.map((cat) => (
          <div id={`modal-bebida-${cat.id}`} class="modal-overlay" onclick={`closeBebidaModal('${cat.id}')`}>
            <div class="modal-content" onclick="event.stopPropagation()">
              <button class="modal-close" onclick={`closeBebidaModal('${cat.id}')`}>✕</button>
              <h3 class="modal-title">{cat.nombre}</h3>
              <p class="subtitle">Marcas y productos disponibles en nuestro bar</p>
              <div class="marcas-grid">
                {cat.marcas.map((m) => (
                  <div class="marca-item">
                    <div class="marca-img-box">
                      <img src={m.img} alt={m.nombre} />
                    </div>
                    <strong>{m.nombre}</strong>
                    <p>{m.desc}</p>
                  </div>
                ))}
              </div>
            </div>
          </div>
        ))}
      </section>

      <!-- Horarios -->
      <section class="card horario-card" id="horarios">
        <h2>HORARIO</h2>
        <p class="subtitle">Nuestro horario de atención</p>
        <ul>
          {horarios.map((item) => (
            <li>
              <span class="dia-texto">{item.dia}</span>
              <strong class="hora-texto">{item.hora}</strong>
            </li>
          ))}
        </ul>
        <div class="esperamos">¡Te esperamos!</div>
      </section>

      <!-- Ubicación -->
      <section class="section" id="ubicacion">
        <h2>UBICACIÓN</h2>
        <p class="subtitle">Barrio Camilo Ponce</p>
        <div class="map-container">
          <iframe 
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3989.816682705011!2d-78.8500!3d-0.0050!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zM8KwMDAnMTguMCJTIDc4wrA1MScwMC4wIlc!5e0!3m2!1ses!2sec!4v1710000000000!5m2!1ses!2sec" 
            width="100%" 
            height="260" 
            style="border:0; border-radius: 12px;" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="no-referrer-when-downgrade">
          </iframe>
          <div class="map-action">
            <a href="https://maps.app.goo.gl/a5GmixC4zKMxaNJe6" target="_blank" rel="noopener noreferrer" class="btn-orange">
              Abrir en Google Maps ➔
            </a>
          </div>
        </div>
      </section>

      <!-- Footer -->
      <footer class="elegant-footer">
        <div class="footer-center">
          <img src="/logo.png" alt="MAU FITNESS Logo" class="footer-logo-center" />
          <p class="footer-motto">¡Más que un gimnasio, una comunidad!</p>
          <div class="footer-social-links">
            <a href="https://www.instagram.com/maufitness.co/" target="_blank" rel="noopener noreferrer">Instagram</a>
            <span class="dot">•</span>
            <a href="https://www.tiktok.com/@maufitness.co" target="_blank" rel="noopener noreferrer">TikTok</a>
            <span class="dot">•</span>
            <a href="https://wa.me/593998974837" target="_blank" rel="noopener noreferrer">WhatsApp</a>
          </div>
          <p class="copy-text">© 2026 MAU FITNESS. Todos los derechos reservados.</p>
        </div>
      </footer>
    </main>

    <!-- Script de Modales -->
    <script is:inline>
      function openPlanModal(id) {
        document.getElementById('modal-plan-' + id).classList.add('active');
        document.body.style.overflow = 'hidden';
      }
      function closePlanModal(id) {
        document.getElementById('modal-plan-' + id).classList.remove('active');
        document.body.style.overflow = 'auto';
      }
      function openRutinaModal(id) {
        document.getElementById('modal-' + id).classList.add('active');
        document.body.style.overflow = 'hidden';
      }
      function closeRutinaModal(id) {
        document.getElementById('modal-' + id).classList.remove('active');
        document.body.style.overflow = 'auto';
      }
      function openBebidaModal(id) {
        document.getElementById('modal-bebida-' + id).classList.add('active');
        document.body.style.overflow = 'hidden';
      }
      function closeBebidaModal(id) {
        document.getElementById('modal-bebida-' + id).classList.remove('active');
        document.body.style.overflow = 'auto';
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg-black: #000000;
    --card-bg: #0a0a0a;
    --card-inner: #121212;
    --border-color: #1a1a1a;
    --orange-brand: #FFA500;
    --orange-hover: #FFB733;
    --text-white: #ffffff;
    --text-muted: #888888;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { background-color: var(--bg-black); color: var(--text-white); padding: 16px; font-family: 'Plus Jakarta Sans', sans-serif; }
  .container { max-width: 1200px; margin: 0 auto; }
  .orange { color: var(--orange-brand); }

  /* Cabecera Unificada y Centrada */
  .header-unificado {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 30px 20px;
    background: var(--card-bg);
    border-radius: 16px;
    margin-bottom: 20px;
    border: 1px solid var(--border-color);
    gap: 20px;
  }
  .brand-logo {
    height: 240px;
    max-height: 70vh;
    width: auto;
    object-fit: contain;
    mix-blend-mode: screen;
  }
  .social-icons-center {
    display: flex;
    gap: 16px;
    justify-content: center;
  }

  /* Efectos interactivos para redes sociales (Hover y Active de pulsación) */
  .social-btn {
    color: var(--text-white);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background: var(--card-inner);
    border-radius: 50%;
    border: 1px solid var(--border-color);
    transition: all 0.2s ease;
  }
  .social-btn:hover {
    background: var(--orange-brand);
    color: #000;
    border-color: var(--orange-brand);
    transform: translateY(-3px) scale(1.05);
  }
  .social-btn:active {
    transform: translateY(1px) scale(0.95);
  }

  /* Hero Principal con Efecto Activo en el botón */
  .hero {
    background: linear-gradient(rgba(0,0,0,0.75), rgba(0,0,0,0.95)), url('https://images.unsplash.com/photo-1534438327276-14e5300c3a48?q=80&w=1200&auto=format&fit=crop') center/cover;
    border-radius: 16px;
    padding: 40px 30px;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 20px;
    border: 1px solid var(--border-color);
  }
  .hero-content h1 { font-size: 2.5rem; font-weight: 800; margin-bottom: 8px; }
  .hero-content p { color: var(--text-muted); }

  .btn-orange {
    background: var(--orange-brand);
    color: #000;
    padding: 14px 28px;
    border-radius: 24px;
    font-weight: 800;
    text-decoration: none;
    display: inline-block;
    text-align: center;
    transition: all 0.2s ease;
    box-shadow: 0 4px 14px rgba(255, 165, 0, 0.3);
  }
  .btn-orange:hover {
    background: var(--orange-hover);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(255, 165, 0, 0.5);
  }
  .btn-orange:active {
    transform: translateY(2px) scale(0.97);
    box-shadow: 0 2px 8px rgba(255, 165, 0, 0.2);
  }

  /* Secciones generales */
  .section, .card {
    background: var(--card-bg); border-radius: 16px; padding: 24px; margin-bottom: 20px; border: 1px solid var(--border-color);
  }
  .section h2, .card h2 { font-size: 1.2rem; font-weight: 800; color: var(--orange-brand); margin-bottom: 4px; }
  .subtitle { color: var(--text-muted); font-size: 0.88rem; margin-bottom: 16px; }

  /* Planes Interactivos */
  .planes-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .plan-card-main { background: var(--card-inner); border-radius: 12px; padding: 20px; border: 1px solid var(--border-color); border-top: 3px solid var(--orange-brand); cursor: pointer; transition: transform 0.2s ease; }
  .plan-card-main:hover { transform: translateY(-3px); }
  .plan-content-box h3 { font-size: 1.1rem; font-weight: 800; color: #fff; margin-bottom: 6px; }
  .plan-content-box p { color: var(--text-muted); font-size: 0.85rem; margin-bottom: 12px; }
  .btn-ver-valores { color: var(--orange-brand); font-size: 0.88rem; font-weight: 700; }

  .modal-precios-list { display: flex; flex-direction: column; gap: 10px; margin-top: 14px; }
  .modal-row { display: flex; justify-content: space-between; background: var(--card-inner); padding: 12px 16px; border-radius: 8px; border: 1px solid var(--border-color); font-size: 0.95rem; color: var(--text-muted); }
  .modal-row strong { color: var(--orange-brand); }

  /* Rutinas Grid */
  .rutinas-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .rutina-card { cursor: pointer; border-radius: 12px; overflow: hidden; border: 1px solid var(--border-color); transition: transform 0.2s ease; }
  .rutina-card:hover { transform: translateY(-4px); }
  .rutina-img-bg { height: 220px; background-size: cover; background-position: center; padding: 14px; display: flex; flex-direction: column; justify-content: space-between; }
