---
const horarios = [
  { dia: "Lunes - Viernes", hora: "05:00 a 09:30 / 14:30 a 22:00" },
  { dia: "Sábados", hora: "06:00 a 09:30 (Tarde cerrado)" },
  { dia: "Domingos", hora: "Cerrado" }
];

const planes = {
  normal: [
    { periodo: "Mensual", precio: "$20" },
    { periodo: "Trimestral", precio: "$40" }
  ],
  estudiantes: [
    { periodo: "Diario", precio: "$1" },
    { periodo: "Mensual", precio: "$15" },
    { periodo: "Trimestral", precio: "$25" }
  ]
};

const rutinas = [
  { classImg: "fuerza-bg", nombre: "Fuerza" },
  { classImg: "cardio-bg", nombre: "Cardio" },
  { classImg: "tonificacion-bg", nombre: "Tonificación" }
];

const areaBar = [
  { nombre: "Agua Vilcagua", img: "https://vilcagua.com.ec/wp-content/uploads/2023/07/vilcagua-500ml-1.jpeg" },
  { nombre: "Proteína Carnivor", img: "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQQc5UXUdR2ttvTYxXSgQ55CXSUoDSFR9DLwfr6XHANrw&s=10" },
  { nombre: "Creatina Beast Bites", img: "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTTvSM_8TYk7Q53bHd19kRWG_t-fxS0WmU8sMkr030_0w&s=10" },
  { nombre: "Creatina Monohidratada RC", img: "https://activelife.ec/wp-content/uploads/2024/08/ronnie-coleman-creatina-120.jpg" },
  { nombre: "Café", img: "https://www.shutterstock.com/image-photo/espresso-coffee-transparent-cup-260nw-2512810809.jpg" }
];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MAU FITNESS - Gimnasio</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <main class="container">
      <header class="navbar">
        <div class="logo-container">
          <img src="/logo.png" alt="MAU FITNESS Logo" class="brand-logo" />
        </div>
        <nav class="nav-links">
          <a href="#" class="active">Inicio</a>
          <a href="#horarios">Horario</a>
          <a href="#planes">Planes y Precios</a>
          <a href="#rutinas">Rutinas</a>
          <a href="#bar">Área de Bar</a>
          <a href="#ubicacion">Ubicación</a>
        </nav>
        <div class="social-icons-top">
          <a href="https://www.instagram.com/maufitness.co/" target="_blank" rel="noopener noreferrer" title="Instagram">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>
          <a href="https://www.tiktok.com/@maufitness.co" target="_blank" rel="noopener noreferrer" title="TikTok">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 1 1-5.2-1.74 2.89 2.89 0 0 1 2.31-2.82V7.65a6.34 6.34 0 0 0-5.36 6.3 6.34 6.34 0 0 0 10.82 4.48c1.64-1.64 2.55-3.87 2.55-6.22V8.92a8.28 8.28 0 0 0 4.86 1.57V7.05a4.84 4.84 0 0 1-2.76-.36z"></path>
            </svg>
          </a>
        </div>
      </header>

      <section class="hero">
        <div class="hero-content">
          <h1>DISCIPLINA HOY, <br /><span class="orange">RESULTADOS MAÑANA</span></h1>
          <p>Tu mejor versión comienza aquí.</p>
        </div>
        <div class="hero-card">
          <a href="https://wa.me/593998974837?text=¡Hola!%20Quiero%20solicitar%20información%20sobre%20los%20planes%20de%20MAU%20FITNESS." target="_blank" rel="noopener noreferrer" class="btn-orange">
            QUIERO MI PLAN ➔
          </a>
        </div>
      </section>

      <section class="info-grid">
        <div class="card horario-card" id="horarios">
          <h2>HORARIO</h2>
          <p class="subtitle">Nuestro horario de atención</p>
          <ul>
            {horarios.map((item) => (
              <li>
                <span>{item.dia}</span>
                <strong>{item.hora}</strong>
              </li>
            ))}
          </ul>
          <div class="esperamos">¡Te esperamos!</div>
        </div>

        <div class="card precios-card" id="planes">
          <h2>PLANES Y PRECIOS</h2>
          <p class="subtitle">Elige el plan que mejor se adapte a ti</p>
          <div class="planes-container">
            <div class="plan normal">
              <h3>PLAN NORMAL</h3>
              {planes.normal.map((p) => (
                <div class="plan-row"><span>{p.periodo}</span> <strong>{p.precio}</strong></div>
              ))}
            </div>
            <div class="plan estudiantes">
              <h3>PLAN ESTUDIANTES</h3>
              {planes.estudiantes.map((p) => (
                <div class="plan-row"><span>{p.periodo}</span> <strong>{p.precio}</strong></div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section class="section" id="rutinas">
        <h2>RUTINAS</h2>
        <p class="subtitle">Entrena con objetivos</p>
        <div class="grid-gallery-3">
          {rutinas.map((item) => (
            <div class={`gallery-item ${item.classImg}`}>
              <div class="overlay-text">{item.nombre}</div>
            </div>
          ))}
        </div>
      </section>

      <section class="section" id="bar">
        <h2>ÁREA DE BAR</h2>
        <p class="subtitle">Recarga energías e hidrátate antes o después de entrenar</p>
        <div class="bar-grid">
          {areaBar.map((item) => (
            <div class="bar-item">
              <div class="bar-img-box">
                <img src={item.img} alt={item.nombre} />
              </div>
              <span>{item.nombre}</span>
            </div>
          ))}
        </div>
      </section>

      <section class="section" id="ubicacion">
        <h2>UBICACIÓN</h2>
        <p class="subtitle">Barrio Camilo Ponce</p>
        <div class="map-container">
          <iframe 
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3989.816682705011!2d-78.8500!3d-0.0050!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zM8KwMDAnMTguMCJTIDc4wrA1MScwMC4wIlc!5e0!3m2!1ses!2sec!4v1710000000000!5m2!1ses!2sec" 
            width="100%" 
            height="300" 
            style="border:0; border-radius: 12px;" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="no-referrer-when-downgrade">
          </iframe>
          <div class="map-action">
            <a href="https://maps.app.goo.gl/a5GmixC4zKMxaNJe6" target="_blank" rel="noopener noreferrer" class="btn-orange">
              Abrir en Google Maps ➔
            </a>
          </div>
        </div>
      </section>

      <!-- Footer Elegante con Logo Grande -->
      <footer class="elegant-footer">
        <div class="footer-center">
          <img src="/logo.png" alt="MAU FITNESS Logo" class="footer-logo-center" />
          <p class="footer-motto">¡Más que un gimnasio, una comunidad!</p>
          <div class="footer-social-links">
            <a href="https://www.instagram.com/maufitness.co/" target="_blank" rel="noopener noreferrer">Instagram</a>
            <span class="dot">•</span>
            <a href="https://www.tiktok.com/@maufitness.co" target="_blank" rel="noopener noreferrer">TikTok</a>
            <span class="dot">•</span>
            <a href="https://wa.me/593998974837" target="_blank" rel="noopener noreferrer">WhatsApp</a>
          </div>
          <p class="copy-text">© 2026 MAU FITNESS. Todos los derechos reservados.</p>
        </div>
      </footer>
    </main>
  </body>
</html>

<style is:global>
  :root {
    --bg-black: #000000;
    --card-bg: #0a0a0a;
    --card-inner: #121212;
    --border-color: #1a1a1a;
    --orange-brand: #FFA500;
    --orange-hover: #FFB733;
    --text-white: #ffffff;
    --text-muted: #888888;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    background-color: var(--bg-black);
    color: var(--text-white);
    padding: 20px;
    font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .orange {
    color: var(--orange-brand);
  }

  .navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 24px;
    background: var(--card-bg);
    border-radius: 12px;
    margin-bottom: 20px;
    border: 1px solid var(--border-color);
  }

  .logo-container {
    display: flex;
    align-items: center;
  }

  .brand-logo {
    height: 70px;
    width: auto;
    object-fit: contain;
    mix-blend-mode: screen;
  }

  .nav-links {
    display: flex;
    gap: 20px;
  }

  .nav-links a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
    transition: color 0.2s ease;
  }

  .nav-links a:hover, .nav-links a.active {
    color: var(--orange-brand);
  }

  .social-icons-top {
    display: flex;
    gap: 10px;
    align-items: center;
  }

  .social-icons-top a {
    color: var(--text-white);
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: var(--card-inner);
    border-radius: 50%;
    border: 1px solid var(--border-color);
    transition: all 0.2s ease;
  }

  .social-icons-top a:hover {
    color: var(--orange-brand);
    border-color: var(--orange-brand);
    transform: translateY(-2px);
  }

  .hero {
    background: linear-gradient(rgba(0,0,0,0.75), rgba(0,0,0,0.95)), url('https://images.unsplash.com/photo-1534438327276-14e5300c3a48?q=80&w=1200&auto=format&fit=crop') center/cover;
    border-radius: 16px;
    padding: 50px 40px;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 20px;
    min-height: 340px;
    border: 1px solid var(--border-color);
  }

  .hero-content h1 {
    font-size: 2.8rem;
    line-height: 1.15;
    font-weight: 800;
    letter-spacing: -0.5px;
    margin-bottom: 8px;
  }

  .hero-content p {
    color: var(--text-muted);
    font-size: 1.1rem;
    font-weight: 500;
  }

  .btn-orange {
    background: var(--orange-brand);
    color: #000000;
    padding: 12px 24px;
    border-radius: 24px;
    text-decoration: none;
    font-weight: 800;
    font-size: 0.9rem;
    display: inline-block;
    box-shadow: 0 4px 18px rgba(255, 165, 0, 0.35);
    transition: all 0.2s ease;
  }

  .btn-orange:hover {
    background: var(--orange-hover);
    transform: translateY(-2px);
  }

  .subtitle {
    color: var(--text-muted);
    font-size: 0.88rem;
    margin-bottom: 16px;
  }

  .info-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 20px;
  }

  .card {
    background: var(--card-bg);
    border-radius: 16px;
    padding: 24px;
    border: 1px solid var(--border-color);
  }

  .card h2, .section h2 {
    font-size: 1.2rem;
    font-weight: 800;
    margin-bottom: 4px;
    color: var(--orange-brand);
    letter-spacing: 0.3px;
  }

  .horario-card ul { list-style: none; }
  .horario-card li {
    display: flex;
    justify-content: space-between;
    padding: 12px 0;
    border-bottom: 1px solid var(--border-color);
    font-size: 0.92rem;
  }

  .esperamos {
    margin-top: 16px;
    color: var(--orange-brand);
    font-style: italic;
    font-weight: 700;
    font-size: 0.9rem;
  }

  .planes-container { 
    display: grid; 
    grid-template-columns: 1fr 1fr; 
    gap: 14px; 
  }

  .plan { 
    background: var(--card-inner); 
    border-radius: 12px; 
    padding: 16px; 
    border: 1px solid var(--border-color); 
    border-top: 3px solid var(--orange-brand);
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .plan:hover {
    border-color: var(--orange-brand);
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(255, 165, 0, 0.2);
  }

  .plan h3 { 
    font-size: 0.88rem; 
    font-weight: 800; 
    margin-bottom: 12px; 
    color: var(--text-white); 
  }

  .plan:hover h3 {
    color: var(--orange-brand);
  }

  .plan-row { 
    display: flex; 
    justify-content: space-between; 
    font-size: 0.88rem; 
    margin-bottom: 8px; 
    color: var(--text-muted); 
  }

  .plan-row strong { 
    color: var(--orange-brand); 
  }

  .section {
    background: var(--card-bg);
    border-radius: 16px;
    padding: 24px;
    margin-bottom: 20px;
    border: 1px solid var(--border-color);
  }

  .grid-gallery-3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .gallery-item {
    background-size: cover;
    background-repeat: no-repeat;
    background-color: var(--card-inner);
    height: 220px;
    border-radius: 12px;
    display: flex;
    align-items: flex-end;
    padding: 12px;
    position: relative;
    border: 1px solid var(--border-color);
    overflow: hidden;
    transition: transform 0.3s ease;
  }

  .gallery-item:hover {
    transform: translateY(-3px);
    border-color: var(--orange-brand);
  }

  .fuerza-bg {
    background-image: linear-gradient(to top, rgba(0, 0, 0, 0.95), rgba(0, 0, 0, 0.2)), url('https://www.basic-fit.com/on/demandware.static/-/Library-Sites-basic-fit-shared-library/default/dw6df7ec4a/Blogs/weight%20lifting%20women.jpg');
    background-position: center;
  }

  .cardio-bg {
    background-image: linear-gradient(to top, rgba(0, 0, 0, 0.95), rgba(0, 0, 0, 0.2)), url('https://media.revistagq.com/photos/61351490db3cd3f3932450c1/1:1/w_2000,h_2000,c_limit/GettyImages-1277242858.jpg');
    background-position: top center;
  }

  .tonificacion-bg {
    background-image: linear-gradient(to top, rgba(0, 0, 0, 0.95), rgba(0, 0, 0, 0.2)), url('https://www.shutterstock.com/image-photo/older-woman-exercising-on-suspension-260nw-2696086219.jpg');
    background-position: center;
  }

  .overlay-text {
    font-size: 0.95rem;
    font-weight: 700;
    background: rgba(10, 10, 10, 0.85);
    backdrop-filter: blur(4px);
    width: 100%;
    padding: 10px;
    text-align: center;
    border-radius: 8px;
    color: var(--text-white);
    border: 1px solid rgba(255,255,255,0.08);
  }

  .bar-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 14px;
  }

  .bar-item {
    background: var(--card-inner);
    border-radius: 12px;
    padding: 14px;
    text-align: center;
    border: 1px solid var(--border-color);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    transition: all 0.2s ease;
  }

  .bar-item:hover {
    transform: translateY(-3px);
    border-color: var(--orange-brand);
  }

  .bar-img-box {
    width: 100%;
    height: 130px;
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #ffffff;
    padding: 8px;
  }

  .bar-img-box img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    transition: transform 0.3s ease;
  }

  .bar-item:hover .bar-img-box img {
    transform: scale(1.08);
  }

  .bar-item span {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-white);
  }

  .map-container {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .map-action {
    text-align: right;
  }

  /* --- STYLES FOR ELEGANT FOOTER --- */
  .elegant-footer {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 40px 20px;
    margin-top: 30px;
    text-align: center;
  }

  .footer-center {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  /* Logo del footer grande y destacado (130px) */
  .footer-logo-center {
    height: 130px;
    width: auto;
    object-fit: contain;
    mix-blend-mode: screen;
  }

  .footer-motto {
    color: var(--orange-brand);
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.3px;
  }

  .footer-social-links {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 4px;
  }

  .footer-social-links a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 600;
    transition: color 0.2s ease;
  }

  .footer-social-links a:hover {
    color: var(--text-white);
  }

  .dot {
    color: var(--border-color);
    font-size: 0.8rem;
  }

  .copy-text {
    color: var(--text-muted);
    font-size: 0.78rem;
    margin-top: 8px;
  }
</style>